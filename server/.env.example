# Required — the Zigbee2MQTT topic of the Lixee ZLinky_TIC plugged into the
# Linky meter. The teleinfo (HCHC/HCHP indexes, PAPP, PTEC) arrives over the
# shared MQTT broker below (MQTT_HOST must be set). No backfill: daily history
# accumulates from the first connection.
LINKY_MQTT_TOPIC=zigbee2mqtt/linky

# Off-peak hours windows (format: HH:MM-HH:MM, comma-separated) — fallback for
# the off-peak split when the live PTEC stream goes quiet (>15 min).
HC_WINDOWS=23:32-5:32,15:02-17:02

# Electricity pricing (€/kWh)
PRICE_HP=0.2065
PRICE_HC=0.1579
PRICE_ABO_MONTHLY=15.65

# Screen-refresh schedule. The ESP32 wakes every SCREEN_REFRESH_INTERVAL_MIN
# minutes (clock-aligned: 00:00, 02:00 … for 120) — must match REFRESH_INTERVAL_MIN
# in the firmware (esp32-display/nvs_config.h). The server regenerates the buffer
# DATA_LEAD_MIN minutes before each of those wakes so the panel always pulls a
# fresh render. SCREEN_WAKE_SKIP_MIN mirrors the firmware's guard: if drift wakes
# the ESP within this many minutes of a boundary it skips it, so the Home panel's
# "next refresh" shows the device's real next wake (keep it equal to the firmware
# `sleep_min < 5` literal).
SCREEN_REFRESH_INTERVAL_MIN=120
DATA_LEAD_MIN=10
SCREEN_WAKE_SKIP_MIN=5

# Intraday strip Y scale — the mini bar-graph under each EDF bar normalises its
# heights to this fixed ceiling (W of mean PAPP at full strip height; a 4h mean
# above it clips). Fixed so day profiles compare across refreshes.
INTRADAY_MAX_W=3000

# Optional — EcoFlow PowerStream solar production (private app credentials).
# When EMAIL/PASSWORD/DEVICE_SN are set, the dashboard adds a daily solar chart.
# Reported PV power is read over the private MQTT broker and integrated into
# daily kWh totals (no historical backfill; history starts at first connection).
ECOFLOW_EMAIL=your_ecoflow_account_email
ECOFLOW_PASSWORD=your_ecoflow_account_password
ECOFLOW_DEVICE_SN=your_powerstream_serial_number
# API host: api-e.ecoflow.com (EU), api.ecoflow.com (global), api-a.ecoflow.com (asia)
ECOFLOW_API_HOST=api-e.ecoflow.com

# Optional — crypto-bot stats panel (top-right). Mirrors the iOS "small" widget.
# Set the GraphQL URL to enable; leave empty to disable. On CasaOS the bot runs
# on the same host, reachable via its LAN IP (bridge network can't use localhost).
CRYPTO_API_URL=http://192.168.1.50:3003/graphql
# Bearer token (the bot's NITRO_API_TOKEN) — omit if the bot has no auth.
CRYPTO_API_TOKEN=your_crypto_bot_api_token

# Shared local MQTT broker for the Zigbee2MQTT / ESPHome slices (the Linky core
# above, power sensors, water). It's the same mosquitto on the LAN, so the host/
# port/credentials live here once; each slice only sets its own topic(s).
# Set MQTT_HOST to enable those slices (empty = all of them disabled). On CasaOS,
# point to the broker's LAN IP (bridge network can't use localhost). EcoFlow's
# cloud broker is separate and does NOT use these.
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
# Broker credentials — omit if the broker allows anonymous connections.
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional — power sensors (bottom-left table rows): any Zigbee2MQTT / ESPHome
# device that reports only instantaneous power (W) and no energy counter. Each is
# integrated into daily kWh ourselves (no backfill) and shown as one table row.
# Declare them all here, ';'-separated, as `topic:Display Name` (the first ':'
# splits topic from label). The label's slug is the storage key, so keep "Cumulus"
# and "Lave-linge" to inherit the history migrated from the old CUMULUS_TOPIC /
# WASHER_TOPIC tables. Set with MQTT_HOST to enable; empty = off.
# Several topics sharing the SAME label are summed into one row (e.g. a "Salon"
# group of plugs): POWER_SENSORS=...;zigbee2mqtt/prise_1:Salon;zigbee2mqtt/prise_2:Salon
POWER_SENSORS=zigbee2mqtt/cumulus:Cumulus;zigbee2mqtt/washing_machine:Lave-linge

# Optional — water meter daily consumption (center "Eau" chart, above the Solar
# chart). The ESPHome wM-Bus reader publishes the meter's cumulative index (m³)
# to mosquitto; the dashboard derives daily litres by index diff (no integration).
# Set the topic (with MQTT_HOST) to enable; empty = off.
# Topic publie par l'ESPHome (duty-cycle WiFi) : index cumulatif en m3 (payload float brut).
WATER_TOPIC=watermeter/index_m3
# Water price (€/m³, water + sanitation from your bill) for the cost figure.
WATER_PRICE_M3=4.30

# Optional — UniFi network panel (bottom-right "Réseau"). Queries the local
# gateway (UCG Ultra / UniFi OS) for internet & Wi-Fi quality, clients per SSID,
# top-3 clients per network and data usage. Set the password to enable; leave
# empty to disable. On CasaOS, use the gateway's LAN IP (bridge network).
UNIFI_HOST=https://192.168.1.1
UNIFI_USERNAME=your_gateway_local_account
UNIFI_PASSWORD=
UNIFI_SITE=default
# Your own SSID names — used to split IoT vs personal client counts and top-3 lists.
UNIFI_SSID_IOT=your_iot_wifi_ssid
UNIFI_SSID_MAIN=your_main_wifi_ssid
